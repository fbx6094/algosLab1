        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    Start([Начало: quickSort left, right]) --&gt; Init[i = left, j = right\\npivot = arr[(left + right) / 2 + 1]]\n    Init --&gt; MainWhile{i &lt;= j}\n\n    MainWhile -- Да --&gt; IncLeft{arr[i] &lt; pivot}\n    IncLeft -- Да --&gt; StepI[i++] --&gt; IncLeft\n    IncLeft -- Нет --&gt; DecRight{arr[j] &gt; pivot}\n\n    DecRight -- Да --&gt; StepJ[j--] --&gt; DecRight\n    DecRight -- Нет --&gt; CheckCross{i &lt;= j}\n\n    CheckCross -- Да --&gt; CheckSwap{i &lt; j &amp;&amp; arr[i] != arr[j]}\n    CheckCross -- Нет --&gt; MainWhile\n\n    CheckSwap -- Да --&gt; DoSwap[swap arr[i], arr[j]\\nswapsCount++] --&gt; NextStep[i++\\nj--]\n    CheckSwap -- Нет --&gt; NextStep\n    NextStep --&gt; MainWhile\n\n    MainWhile -- Нет --&gt; RecLeftCheck{left &lt; j}\n    RecLeftCheck -- Да --&gt; RecLeft[quickSort left, j] --&gt; RecRightCheck{i &lt; right}\n    RecLeftCheck -- Нет --&gt; RecRightCheck\n\n    RecRightCheck -- Да --&gt; RecRight[quickSort i, right] --&gt; End([Конец])\n    RecRightCheck -- Нет --&gt; End&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="242xIs1QH8rAjySMIbl7-1">
